# 复制为 local.toml（已被 .gitignore 忽略）后填写本机覆盖；见
# https://unixnu.com/zh/porting/device-repository#本地开发
# 解析优先级：--local-module > --local-<kind> > --local > feeds.toml 的 local / 本文件 > 设备仓 > SoC 仓 > 基础仓 > git 源码。

# 构建驱动（unixnu CLI）与 UEFI 的种子检出。留空则用 feeds 里固定的 git 源码。
# [[source]]
# kind = "refer"
# name = "xnu"
# local = "../xnu-0b4b910d"

# SoC / 驱动 / kit 的本地检出（本仓当前把驱动放在子模块 drivers/ShengUfs）。
# [[source]]
# kind = "driver"
# name = "ShengUfs"
# local = "../ShengUfs"

# 工具链与固件根：本仓实测 /opt/unixnu-linux 里没有 ld，必须指向自带
# CommandLineTools/usr/bin/ld 的那套；UNIXNU_UEFI 不导出则 panic 上屏编不过
# （缺 Mu-Silicium FrameBufferSerialPortLib/Font.h）。
# [paths]
# toolchain = "../toolchain"
# uefi = "../uefi-liuqin"
