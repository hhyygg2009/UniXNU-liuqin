+                string_index, = struct.unpack_from('<I', data, entry)
+                start = strings + string_index
+                end = data.index(b'\0', start)
+                if data[start:end] == name.encode():
+                    data[entry + 4] |= 0x01      # N_EXT
+                    path.write_bytes(data)
+                    return True
+            return False
+        offset += size
+    return False
