+def globalize(path, name):
+    data = bytearray(path.read_bytes())
+    magic, _, _, _, commands, _, _, _ = struct.unpack_from('<8I', data, 0)
+    if magic != 0xfeedfacf:
+        raise SystemExit(f'{path}: not a 64-bit Mach-O')
+    offset = 32
