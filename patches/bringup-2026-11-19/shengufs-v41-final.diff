+static void lqJournal (uint32_t code)
+{
+    if (!gJournalLba) return;
+    uint64_t stamp = mach_absolute_time ();
+    memset (gJournalPage, 0, sizeof gJournalPage);
+    uint32_t magic = LIQ_JOURNAL_MAGIC;
+    memcpy (gJournalPage + 0, &magic, sizeof magic);
+    memcpy (gJournalPage + 4, &code, sizeof code);
+    memcpy (gJournalPage + 8, &stamp, sizeof stamp);
+    (void) hostWrite4k (0, gJournalLba, 1, gJournalPage);
