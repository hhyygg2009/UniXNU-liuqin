 OSDefineMetaClassAndStructors (NativeUfsBlock, IOBlockStorageDevice)
 
+// ---- liuqin (H16-F, v39): controlled repair of the block class's superClassLink ----
+// The boot C++ pass constructs this class's metaclass with the family's metaclass and
+// something then writes eight bytes of console text over superClassLink (offset +0x10)
+// before OSMetaClass::postModLoad walks the ancestor chain. The H16-E scan in
+// patches/xnu/zzzzzzzzzz-liuqin-metaclass-stalled-diagnostics.patch survives that by
+// dropping the slot, which also keeps this class out of sAllClassesDict -- and a dropped
+// slot is not the same thing as a usable class.
+//
+// The value the field has to hold is not a compile-time constant in this port: it is
+// whichever metaclass IOStorageFamily registered under "IOBlockStorageDevice", and the
+// family is already in the prelinked closure by the time the root is started. So the
+// field is put back at a controlled time instead of being restated at link time.
+//
+// The layout below is the one the H16-E diagnostics already validate against the shipped
+// image: vtable +0x00, reserved +0x08, superClassLink +0x10, className +0x18,
+// classSize +0x20. If OSMetaClass ever changes shape, getClassSize() no longer reads
+// sizeof(NativeUfsBlock) and the ABI gate in startRoot refuses before any write.
+struct LiqMetaShim {
+  const void        *vtable;
+  const void        *reserved;
+  const OSMetaClass *superClassLink;
+  const void        *className;
+  unsigned int       classSize;
+};
+
+// The family's registered metaclass, or null while IOStorageFamily is not there yet.
+static const OSMetaClass *liuqinBlockSuperClass (void)
+{
+  const OSSymbol *name = OSSymbol::withCString ("IOBlockStorageDevice");
+  if (!name) return nullptr;
+  const OSMetaClass *base = OSMetaClass::getMetaClassWithName (name);
+  name->release ();
+  return base;
+}
+
+// Bounded, never dereferences an implausible pointer: the same validation the XNU-side
+// scan uses, applied to our own chain after the repair.
+static bool liuqinBlockChainOk (const OSMetaClass *meta)
+{
+  const void *cur = meta;
+  for (unsigned hops = 0; cur; ++hops) {
+    if ((uintptr_t)cur < 0xfffffff000000000ULL || hops > 64) return false;
+    cur = static_cast<const LiqMetaShim *> (cur)->superClassLink;
+  }
+  return true;
+}
+
+// Rewrites superClassLink only when it differs, so a re-offer is a no-op and never a
+// second registration (the H16 reentrancy lesson). Returns true when it wrote.
+static bool liuqinBlockAdoptSuperClass (const OSMetaClass *base, const char *phase)
+{
+  LiqMetaShim *shim = reinterpret_cast<LiqMetaShim *> (
+      const_cast<OSMetaClass *> (NativeUfsBlock::metaClass));
+  char line[160];
+  __builtin_snprintf (line, sizeof line, "NativeUfs: M:reg %s p=%p link=%p\n",
+                      phase, (const void *)shim, (const void *)shim->superClassLink);
+  liuqin_debug_puts (line);                 // H11: panel console, never the silent KDB path
+  if (shim->superClassLink == base) return false;
+  shim->superClassLink = base;
+  __builtin_snprintf (line, sizeof line, "NativeUfs: M:reg %s fixed link=%p\n",
+                      phase, (const void *)shim->superClassLink);
+  liuqin_debug_puts (line);
+  return true;
+}
+
+// Set by startRoot so the publisher thread can re-arm before every allocation without
+// another family lookup (and so a poison that comes back is caught, not inherited).
+static const OSMetaClass *gBlockSuperClass = nullptr;
+
 #if defined(NATIVE_UFS_SOURCE_API) && NATIVE_UFS_SOURCE_API
