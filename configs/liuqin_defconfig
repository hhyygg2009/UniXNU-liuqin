# Kernel configuration of the liuqin image (derived from sheng_defconfig). CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build.

CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_NATIVE_UFS_VERIFIED=n
CONFIG_XNU_NATIVE_AES=n
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=n
CONFIG_XNU_NATIVE_RAM_BLOCK=n
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_SOURCE_MOCKFS=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_VERIFIED_ROOT_PROBE=n
CONFIG_XNU_OWNER_ROOT_AUDIT=n
CONFIG_XNU_OWNER_ROOT_TRUST=n
# TODO(liuqin): 暂用 sheng 的 SMEM/PMGR 探测代码，需在 SM8475 上验证或改名
CONFIG_XNU_SHENG_PMGR=y
CONFIG_XNU_OWNER_CACHE_MOUNT=n
CONFIG_XNU_OWNER_CACHE_STARTUP=n
CONFIG_XNU_OWNER_BOOT_MANIFEST=n
CONFIG_XNU_OWNER_DATA_MOUNT=n
CONFIG_XNU_OWNER_UNION_SYSTEMOS=n
CONFIG_XNU_DT_PANIC_REGION=y
# liuqin ADT has no pram node: keep gPanicBase valid with a kernel-owned 128 KiB buffer.
CONFIG_XNU_LIUQIN_VOLATILE_PANIC_LOG=y
CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
# The liuqin-build tree has no scripts/build-boot-progress.py or libBootProgress.a, so
# XNU_BOOT_PROGRESS=1 dies in the bootstrap pass. The K/B/U/I/M panel lines are
# unaffected: liuqin_debug_puts() writes through liuqin_fb_putc(), which binds the
# framebuffer from the fb boot argument itself.
CONFIG_XNU_BOOT_PROGRESS=n
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
# TODO(liuqin): sheng 的 Adreno 研究针对 A740，liuqin 是 A730
CONFIG_XNU_NATIVE_ADRENO=n

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
# TODO(liuqin): 换成本机 scratch Data 卷 UUID（sheng 的值仅为占位）
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="18AB5557-DC2D-469B-8758-855E60F5B0DF"
CONFIG_XNU_OWNER_ROOT_VOLUME_UUID="18AB5557-DC2D-469B-8758-855E60F5B0DF"
CONFIG_XNU_NATIVE_VIRTIO_BLOCK_ARCHIVE=""
CONFIG_XNU_VERIFIED_ROOT_ARCHIVE=""
CONFIG_XNU_EXTRA_LD_ARCHIVES=""
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_ARMVIRT_PLATFORM=n

